<%# locals: (account:) %>

<div class="grid grid-cols-3 gap-2">
  <%= summary_card title: t(".make_model") do %>
    <%= [account.vehicle.make, account.vehicle.model].compact.join(" ").presence || t(".unknown") %>
  <% end %>

  <%= summary_card title: t(".year") do %>
    <%= account.vehicle.year || t(".unknown") %>
  <% end %>

  <%= summary_card title: t(".mileage") do %>
    <%= account.vehicle.mileage || t(".unknown") %>
  <% end %>

  <%= summary_card title: t(".purchase_price") do %>
    <%= format_money account.vehicle.purchase_price %>
  <% end %>

  <%= summary_card title: t(".current_price") do %>
    <%= format_money account.balance_money %>
  <% end %>

  <%= summary_card title: t(".trend") do %>
    <div class="flex items-center gap-1" style="color: <%= account.vehicle.trend.color %>">
      <p class="text-xl font-medium">
        <%= account.vehicle.trend.value %>
      </p>

      <p>(<%= account.vehicle.trend.percent %>%)</p>
    </div>
  <% end %>
</div>

<% if account.vehicle.avm_provider.present? && account.active? && account.permission_for(Current.user).in?([ :owner, :full_control ]) %>
  <div class="flex flex-col items-center gap-1 pt-6">
    <%= render DS::Button.new(
      text: t(".refresh_valuation"),
      href: refresh_valuation_vehicle_path(account),
      method: :post,
      variant: "outline",
      icon: "refresh-cw",
      confirm: CustomConfirm.new(
        title: t(".refresh_confirm_title"),
        body: t(".refresh_confirm_body", provider: t("vehicles.avm_providers.#{account.vehicle.avm_provider}")),
        btn_text: t(".refresh_confirm_button")
      )
    ) %>
    <p class="text-xs text-secondary">
      <%= account.vehicle.avm_last_synced_on ? t(".last_refreshed", date: l(account.vehicle.avm_last_synced_on, format: :long)) : t(".never_refreshed") %>
    </p>
  </div>
<% end %>

<div class="flex justify-center py-8">
  <%= render DS::Link.new(
    text: t(".edit_account_details"),
    variant: "ghost",
    href: edit_vehicle_path(account),
    frame: :modal
  ) %>
</div>
