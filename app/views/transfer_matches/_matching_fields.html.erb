<%# locals: (form:, entry:, candidates:, accounts:, rejected_entry_ids: []) %>

<% if candidates.any? %>
  <div data-controller="transfer-match" class="space-y-2">
    <p class="text-sm text-secondary">
      <%= t(".select_method") %>
    </p>

    <%= form.select :method,
              [
                [t(".match_existing_recommended"), "existing"],
                [t(".create_new_transaction"), "new"]
              ],
              { selected: "existing", label: t(".matching_method") },
              data: { action: "change->transfer-match#update" } %>

    <div data-transfer-match-target="existingSelect">
      <%# Pairs rejected before are still offered, but last and labelled, so the
          default choice stays a fresh candidate. %>
      <% fresh, rejected = candidates.partition { |candidate| rejected_entry_ids.exclude?(candidate.id) } %>
      <%= form.select :matched_entry_id,
                fresh.map { |candidate| [entry_name_detailed(candidate), candidate.id] } +
                  rejected.map { |candidate| [t(".previously_rejected", name: entry_name_detailed(candidate)), candidate.id] },
                { label: t(".matching_transaction") } %>
      <% if rejected.any? %>
        <p class="text-xs text-secondary"><%= t(".previously_rejected_hint") %></p>
      <% end %>
    </div>

    <div data-transfer-match-target="newSelect" class="hidden">
      <%= form.select :target_account_id,
                accounts.map { |account| [account.name, account.id] },
                { label: t(".target_account") } %>
    </div>
  </div>
<% else %>
  <p class="text-sm text-secondary">
    <%= t(".no_matching_transactions") %>
  </p>

  <%= form.hidden_field :method, value: "new" %>

  <div>
    <%= form.select :target_account_id,
                accounts.map { |account| [account.name, account.id] },
                { label: t(".target_account") } %>
  </div>
<% end %>
