<%# locals: (details:) %>
<div class="px-3 py-2 space-y-3">
  <% if details[:kind].in?(%i[simplefin plaid import retail]) %>
    <%# build_transaction_extra_details already drops blank values, so every
        key present here has something to show. Its keys double as locale
        keys: payee/description/memo for SimpleFIN, original_description/
        payment_channel/transaction_code for Plaid, original_description for imports. %>
    <% named_details = details[details[:kind]] %>
    <% if named_details.present? %>
      <dl class="space-y-2">
        <% named_details.each do |key, value| %>
          <%= render DS::DetailRow.new(label: t("transactions.show.#{key}"), value: value) %>
        <% end %>
      </dl>
    <% end %>
    <% if details[:provider_extras].present? %>
      <div class="pt-2">
        <h4 class="text-sm text-secondary mb-1"><%= t("transactions.show.provider_extras") %></h4>
        <dl class="space-y-2">
          <% details[:provider_extras].each do |ex| %>
            <% if ex[:multiline] %>
              <div class="space-y-1">
                <dt class="text-secondary text-sm"><%= ex[:key] %></dt>
                <dd>
                  <pre class="text-xs text-secondary bg-surface-inset rounded p-2 overflow-auto whitespace-pre-wrap break-words"><%= ex[:value] %></pre>
                </dd>
              </div>
            <% else %>
              <%= render DS::DetailRow.new(label: ex[:key], value: ex[:value]) %>
            <% end %>
          <% end %>
        </dl>
      </div>
    <% end %>
  <% else %>
    <pre class="text-xs text-secondary bg-surface-inset rounded p-2 overflow-auto whitespace-pre-wrap break-words"><%= details[:raw] %></pre>
  <% end %>
</div>
