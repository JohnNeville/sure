<%# locals: (form:) %>

<div class="p-2 space-y-3">
  <div class="flex items-center gap-3" data-filter-name="reviewed">
    <%= form.check_box :reviewed,
                           {
                             multiple: true,
                             checked: @q[:reviewed]&.include?("reviewed"),
                             class: "checkbox checkbox--light"
                           },
                           "reviewed",
                           nil %>
    <%= form.label :reviewed, t(".reviewed"), value: "reviewed", class: "text-sm text-primary" %>
  </div>
  <div class="flex items-center gap-3" data-filter-name="unreviewed">
    <%= form.check_box :reviewed,
                           {
                             multiple: true,
                             checked: @q[:reviewed]&.include?("unreviewed"),
                             class: "checkbox checkbox--light"
                           },
                           "unreviewed",
                           nil %>
    <%= form.label :reviewed, t(".unreviewed"), value: "unreviewed", class: "text-sm text-primary" %>
  </div>
</div>
