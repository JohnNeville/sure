<%# locals: (form:) %>

<div class="p-2 space-y-3">
  <div class="flex items-center gap-3" data-filter-name="excluded">
    <%= form.check_box :exclusion,
                           {
                             multiple: true,
                             checked: @q[:exclusion]&.include?("excluded"),
                             class: "checkbox checkbox--light"
                           },
                           "excluded",
                           nil %>
    <%= form.label :exclusion, t(".excluded"), value: "excluded", class: "text-sm text-primary" %>
  </div>
  <div class="flex items-center gap-3" data-filter-name="included">
    <%= form.check_box :exclusion,
                           {
                             multiple: true,
                             checked: @q[:exclusion]&.include?("included"),
                             class: "checkbox checkbox--light"
                           },
                           "included",
                           nil %>
    <%= form.label :exclusion, t(".included"), value: "included", class: "text-sm text-primary" %>
  </div>
</div>
